<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#F8FAFC"
    android:layout_marginTop="6dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvWorkerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Worker Username"
            android:textStyle="bold"
            android:textColor="#0F172A"/>

        <TextView
            android:id="@+id/tvBidAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="₹850.00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#16A34A"/>
    </RelativeLayout>

    <TextView
        android:id="@+id/tvBidMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Can complete in 1 hour."
        android:textSize="13sp"
        android:textColor="#64748B"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnAcceptBid"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Accept Bid"
        android:textSize="12sp"
        android:paddingHorizontal="16dp"
        android:layout_gravity="end"/>

</LinearLayout>
